# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Postgres connection string. On Railway, set this to the service reference:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
# For local dev, use the PUBLIC proxy URL from Railway (host ends in .proxy.rlwy.net).
DATABASE_URL=postgresql://user:password@host:port/dbname

# Port the server listens on. Defaults to 3000 if unset (Railway injects its own).
PORT=3000

# Secret used to sign session cookies. Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
